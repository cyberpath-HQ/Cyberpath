{
  "name": "cyberpath",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro check && npx puppeteer browsers install chrome && astro build && astro preferences disable devToolbar && node ./scripts/check-markdown-variants.mjs && node ./scripts/screenshot.js",
    "preview": "astro preview",
    "astro": "astro",
    "check:markdown": "node ./scripts/check-markdown-variants.mjs",
    "check:markdown:remote": "node ./scripts/check-markdown-variants.mjs --remote https://cyberpath-hq.com",
    "worker:dev": "wrangler dev --config worker/wrangler.jsonc",
    "worker:deploy": "wrangler deploy --config worker/wrangler.jsonc",
    "worker:check": "tsc -p worker/tsconfig.json"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/mdx": "^5.0.4",
    "@astrojs/react": "^5.0.4",
    "@astrojs/rss": "^4.0.18",
    "@astrojs/sitemap": "^3.7.2",
    "@astrolib/seo": "1.0.0-beta.8",
    "@expressive-code/plugin-collapsible-sections": "^0.42.0",
    "@expressive-code/plugin-line-numbers": "^0.42.0",
    "@fontsource-variable/nunito": "^5.2.7",
    "@headlessui/react": "^2.2.10",
    "@panzoom/panzoom": "^4.6.2",
    "@playform/compress": "^0.2.3",
    "@playform/inline": "^0.1.4",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@tailwindcss/vite": "^4.2.4",
    "astro": "^6.2.2",
    "astro-expressive-code": "^0.42.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^11.18.2",
    "fuse.js": "^7.3.0",
    "glob": "^13.0.6",
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.14.0",
    "radash": "^12.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "reading-time": "^1.5.0",
    "remark": "^15.0.1",
    "remark-mdx": "^3.1.1",
    "shiki": "^3.23.0",
    "tailwind-merge": "^3.5.0",
    "typescript": "^5.9.3",
    "unist-util-remove": "^4.0.0",
    "unist-util-visit": "^5.1.0",
    "vfile": "^6.0.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261024.1",
    "@mermaid-js/mermaid-cli": "^11.14.0",
    "@stylistic/eslint-plugin-js": "^4.4.1",
    "@stylistic/eslint-plugin-ts": "^4.4.1",
    "@tailwindcss/typography": "^0.5.19",
    "@types/mdast": "^4.0.4",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "eslint": "^9.39.4",
    "globals": "^16.5.0",
    "jiti": "^2.6.1",
    "puppeteer": "^23.11.1",
    "schema-dts": "^2.0.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.2.4",
    "tw-animate-css": "^1.4.0",
    "typescript-eslint": "^8.59.1",
    "wrangler": "^4.152.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ],
    "ignoredBuiltDependencies": [
      "puppeteer"
    ]
  }
