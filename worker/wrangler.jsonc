{
    "$schema": "../node_modules/wrangler/config-schema.json",
    "name": "cyberpath-markdown-negotiation",
    "main": "index.ts",
    "compatibility_date": "2026-09-01",
    "workers_dev": false,
    "preview_urls": false,
    "observability": {
        "enabled": false
    },
    "routes": [
        {
            "pattern": "cyberpath-hq.com/*",
            "zone_name": "cyberpath-hq.com"
        },
        {
            "pattern": "www.cyberpath-hq.com/*",
            "zone_name": "cyberpath-hq.com"
        }
    ]
}
